# ============================================================
# RefrallBot — نمونه فایل تنظیمات محیطی
# این فایل را به .env کپی کنید و مقادیر را پر کنید.
# هرگز فایل .env واقعی را در گیت ذخیره نکنید.
# ============================================================

APP_NAME="رفرال‌بات"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
# اگر پروژه در زیرپوشه نصب می‌شود، مسیر پایه را وارد کنید (مثال: /refrallbot)
APP_BASE_PATH=
APP_TIMEZONE=Asia/Tehran

# کلید رمزنگاری (۳۲ بایت هگز) — با دستور:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ---------------------------------------------------------------- دیتابیس
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=refrallbot
DB_USERNAME=refrallbot
DB_PASSWORD=

# ---------------------------------------------------------------- امنیت / نشست
SESSION_SECURE=auto
TRUSTED_PROXIES=

# ---------------------------------------------------------------- زمان‌بندی
# فاصله بین ارسال پیام‌های همگانی (میلی‌ثانیه) — برای هاست اشتراکی منطقی است
BROADCAST_DELAY_MS=60
# حداکثر تلاش برای خطاهای گذرا (مثلاً 429/قطع شبکه) در هر گیرنده
BROADCAST_MAX_ATTEMPTS=3
# حداکثر بودجه زمانی هر اجرای Cron همگانی (ثانیه)
BROADCAST_CRON_BUDGET_SECONDS=20
# نگهداری لاگ‌ها و رویدادها (روز)
LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------- نصب
# پس از اتمام نصب توسط ویزارد، این مقدار به true تغییر می‌کند
RB_INSTALLED=false
